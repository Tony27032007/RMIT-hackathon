# Backend environment. Copy this file to .env for local development.
PORT=3000
SQLITE_PATH=data/hearth.sqlite

# Export the Tide-specific adapter (must contain embedded `jwk.keys`) here.
TIDECLOAK_ADAPTER_PATH=public/tidecloak.json

# Leave TRUST_PROXY=false for direct local use. Set true only behind a trusted
# reverse proxy that overwrites X-Forwarded-Host and X-Forwarded-Proto.
TRUST_PROXY=false
# Optional fixed browser-visible origin, e.g. http://localhost:3000.
# PUBLIC_ORIGIN=

# S3-compatible storage. Use an AWS profile or the AWS SDK credential chain;
# never put credentials in source files. The bucket must remain private.
AWS_REGION=ap-southeast-2
# AWS_PROFILE=your-local-profile
S3_BUCKET=
# Optional endpoint and path-style addressing for S3-compatible services.
# S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
